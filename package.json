{
  "name": "lamplit-reading-atlas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "data:build": "node scripts/build-data.mjs",
    "data:check": "node scripts/check-data.mjs",
    "test": "node --experimental-strip-types --test tests/domain.test.ts",
    "check": "npm run data:check && npm test && npm run build",
    "test:e2e": "playwright test",
    "preview:local": "node scripts/serve.mjs",
    "preview:rebuild": "node scripts/build-local-preview.mjs",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@antv/g6": "5.1.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.51.1",
    "@tailwindcss/vite": "4.1.10",
    "@types/node": "22.13.10",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "tailwindcss": "4.1.10",
    "typescript": "5.8.3",
    "vite": "6.4.1"
  }
}
