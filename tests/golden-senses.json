      "expect": [
        "劳驾",
        "打扰"
      ],
      "notExpect": [
        "原谅",
        "借口"
      ],
      "note": "语块 excuse me 的整体意思，不是 excuse 的词义。"
    },
    {
      "id": "course-in-of-course",
      "sentenceId": "b1-022-s002",
      "kpId": "w-course",
